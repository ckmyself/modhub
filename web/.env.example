# 数据库
# 开发环境（SQLite，默认）
DATABASE_URL="file:./prisma/dev.db"
# 生产环境（PostgreSQL，部署时取消注释）
# DATABASE_URL="postgresql://user:password@host:5432/modhub?schema=public"

# 数据库类型：sqlite（开发）或 postgres（生产）
DATABASE_PROVIDER=sqlite

# NextAuth.js
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"

# SMTP 邮件（可选，用于邮箱验证）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-password
# SMTP_FROM=ModHub <noreply@yourdomain.com>
