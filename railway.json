{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "preDeployCommand": "npx prisma db push",
    "startCommand": "npm start",
    "healthcheckPath": "/api/games",
    "healthcheckTimeout": 100,
    "numReplicas": 1
  }
}
